<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="15dp" android:background="@drawable/next_ddl_widget_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="27dp" android:layout_height="27dp"
            android:src="@mipmap/ic_launcher" android:contentDescription="@string/widget_name" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="9dp"
            android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_brand" android:textColor="@color/widget_text"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.08" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_focus_label" android:textColor="@color/widget_secondary"
                android:textSize="9sp" android:letterSpacing="0.05" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="9dp"
        android:text="@string/widget_empty" android:textColor="@color/widget_text"
        android:textSize="17sp" android:textStyle="bold" android:maxLines="1"
        android:ellipsize="end" />
    <TextView android:id="@+id/widget_empty_hint" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:text="@string/widget_empty_hint" android:textColor="@color/widget_secondary"
        android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />

    <LinearLayout android:id="@+id/widget_details" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_next_label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/widget_next_label"
            android:textColor="@color/widget_secondary" android:textSize="10sp"
            android:textStyle="bold" android:letterSpacing="0.04" />
        <TextView android:id="@+id/widget_node" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:textColor="@color/widget_text" android:textSize="14sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_countdown_label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:text="@string/widget_remaining_label" android:textColor="@color/widget_secondary"
            android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_countdown" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/widget_accent"
            android:textSize="25sp" android:textStyle="bold" android:maxLines="1"
            android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/widget_final_label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/widget_final_label"
                android:textColor="@color/widget_secondary" android:textSize="10sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/widget_final" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="5dp" android:textColor="@color/widget_text"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="@string/widget_refresh_hint" android:textColor="@color/widget_secondary"
        android:textSize="9sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
