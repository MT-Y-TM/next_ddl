<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_picker_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@color/widget_secondary" />
    <LinearLayout
        android:id="@+id/widget_picker_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/widget_picker_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_picker_title"
            android:textColor="@color/widget_text"
            android:textSize="22sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/widget_picker_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_picker_cancel"
            android:padding="12dp"
            android:src="@drawable/ic_widget_picker_close"
            android:tint="@color/widget_secondary" />
    </LinearLayout>
    <ListView
        android:id="@+id/widget_picker_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="vertical"
        android:nestedScrollingEnabled="true" />
    <TextView
        android:id="@+id/widget_picker_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_secondary"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>
